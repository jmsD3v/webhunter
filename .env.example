# WebHunter — Environment Variables
# Copy this file to .env and fill in your values

# AI analysis — set ONE of the following (priority if multiple are set:
# ANTHROPIC_API_KEY > GEMINI_API_KEY > OPENAI_API_KEY)
# Optional overall — skip all three to run without AI analysis.
# Gemini: free key at https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Extra authorized targets beyond built-in scope
# Comma-separated: IPs, CIDRs, hostnames, or domains
# Example: AUTHORIZED_SCOPE=192.168.1.0/24,mytestapp.com,staging.internal
AUTHORIZED_SCOPE=
